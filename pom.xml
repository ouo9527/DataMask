<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.ouo9527</groupId>
    <artifactId>data-mask</artifactId>
    <version>2.1.0</version>
    <name>mask</name>
    <description>无感脱敏</description>
    <url>https://gitee.com/ouo9527/data-mask</url>
    <!-- 协议消息 -->
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>
    <!-- 开发者消息 -->
    <developers>
        <developer>
            <name>ouo</name>
            <email>1337819509@qq.com</email>
        </developer>
    </developers>
    <!-- 代码仓库配置 -->
    <scm>
        <connection>scm:git@gitee.com:ouo9527/data-mask.git</connection>
        <developerConnection>scm:git@gitee.com:ouo9527/data-mask.git</developerConnection>
        <url>https://gitee.com/ouo9527/data-mask</url>
    </scm>
    <properties>
        <java.version>8</java.version>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.encoding>UTF-8</maven.compiler.encoding>

        <maven-source-plugin.version>3.2.1</maven-source-plugin.version>
        <maven-javadoc-plugin.version>3.4.1</maven-javadoc-plugin.version>
        <maven-jar-plugin.version>3.2.2</maven-jar-plugin.version>
        <!-- 直接通过mvn deploy上传到目标仓库，无Staging概念‌，立即生效（不适合Central发布），一般用于内部私有仓库发布 -->
        <maven-deploy-plugin.version>2.8.2</maven-deploy-plugin.version>
        <!-- 签名构件包 -->
        <maven-gpg-plugin.version>3.1.0</maven-gpg-plugin.version>
        <!-- 通过mvn deploy上传到‌Staging临时仓库，需人工验证后发布，若签名构件包则需要maven-gpg-plugin -->
        <nexus-staging-maven-plugin.version>1.7.0</nexus-staging-maven-plugin.version>
        <!-- 跳过‌Staging临时仓库，直接发布到Maven Central，无需手动干预暂存仓库管理，适用于自动化CI/CD流程 -->
        <central-publishing-maven-plugin.version>0.6.0</central-publishing-maven-plugin.version>

        <!-- 跳过测试和源码打包 -->
        <!-- 跳过测试： 1、采用参数命令： mvn clean package -Dmaven.test.skip=true 或mvn clean package -DskipTests
          2、在 IDEA 的 Maven 可视化面板里点击即可，也可在上方勾选跳过测试的图标（绿色的闪电⚡）
          3、在项目的 pom 文件的 <rule> 下配置 <skipTests>true</skipTests>
            是由于spring-boot-maven-plugin 插件集成了maven-surefire-plugin 插件，会自动运行 junit test
        -->
        <maven.test.skip>true</maven.test.skip>
        <!--<maven.source.skip>false</maven.source.skip>-->

        <!-- 依赖 -->
        <spring.version>5.3.34</spring.version>
        <spring-boot.version>2.7.18</spring-boot.version>
        <!-- jackson<->bean -->
        <fastjson2.version>2.0.8</fastjson2.version>
        <!-- xml<->bean -->
        <!--<dom4j.version>2.1.4</dom4j.version>-->
        <!-- XPath -->
        <!--<jaxen.version>1.1.6</jaxen.version>-->
        <jackson.version>2.15.4</jackson.version>
        <!-- Hutool -->
        <hutool.version>5.8.38</hutool.version>
        <!-- bouncycastle：密钥算法 -->
        <bouncycastle.version>1.75</bouncycastle.version>
        <!-- 高性能深拷贝：Kryo、FST(2.x-JDK1.7及以上、3.x-JDK14及以上) -->
        <!--<fst.version>2.57</fst.version>-->
        <kryo.version>5.6.2</kryo.version>
        <!-- 高性能对象序例化/反序列化 -->
        <orika.version>1.5.4</orika.version>
        <!-- 高性能XML处理 -->
        <vtd.version>2.13.4</vtd.version>
        <!-- jmh：单元级性能压测 -->
        <jmh.version>1.37</jmh.version>
    </properties>
    <!-- 介质仓库配置 -->
    <!--<distributionManagement>
        &lt;!&ndash; Legacy OSSRH (旧方式)，采用nexus-staging-maven-plugin插件发布 &ndash;&gt;
        <snapshotRepository>
            <id>ossrh</id>
            <url>https://oss.sonatype.org/content/repositories/snapshots/</url>
            &lt;!&ndash;<url>https://s01.oss.sonatype.org/content/repositories/snapshots/</url>&ndash;&gt;
        </snapshotRepository>
        <repository>
            <id>ossrh</id>
            <url>https://oss.sonatype.org/service/local/staging/deploy/maven2/</url>
            &lt;!&ndash;<url>https://s01.oss.sonatype.org/service/local/staging/deploy/maven2/</url>&ndash;&gt;
        </repository>
    </distributionManagement>-->

    <dependencyManagement>
        <dependencies>
            <!-- Jackson BOM依赖 -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring Boot BOM依赖管理 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring BOM依赖管理 -->
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-framework-bom</artifactId>
                <version>${spring.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Hutool BOM依赖 -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-bom</artifactId>
                <version>${hutool.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- spring -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <optional>true</optional>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <optional>true</optional>
            <scope>provided</scope>
        </dependency>
        <!--
            spring-boot-configuration-processor其实是一个注解处理器，在编译阶段干活的，一般在maven的声明都是 ,optional 为true;
            在打包时从用@ConfigurationProperties注释的项轻松生成自己的配置元数据文件
        -->
        <!--<dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>-->
        <!-- propertiestojson: 解决properties文件转Map时，将key中属性引用变成对象（不建议使用，依赖Gson） -->
        <!--<dependency>
            <groupId>pl.jalokim.propertiestojson</groupId>
            <artifactId>java-rule-to-jackson</artifactId>
            <version>${propertiestojson.version}</version>
            <optional>true</optional>
        </dependency>-->
        <!-- yaml、rule、json三者互转 -->
        <!--<dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-rule</artifactId>
            <optional>true</optional>
        </dependency>-->
        <!-- xml<->bean：依赖StAX 实现（如 Woodstox）-->
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-xml</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.module</groupId>
            <!-- 基于ByteBuddy（对现代JVM兼容性好）-->
            <artifactId>jackson-module-blackbird</artifactId>
            <!-- 基于ASM（对Java9+兼容性差）-->
            <!--<artifactId>jackson-module-afterburner</artifactId>-->
        </dependency>
        <!-- Kryo：依赖objenesis -->
        <dependency>
            <groupId>com.esotericsoftware</groupId>
            <artifactId>kryo</artifactId>
            <version>${kryo.version}</version>
        </dependency>
        <!-- hutool -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-crypto</artifactId>
        </dependency>
        <!-- 加密 -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk15to18</artifactId>
            <version>${bouncycastle.version}</version>
            <optional>true</optional>
        </dependency>
        <!-- 日志 -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 类冗余代码生成（如：getter/setter、toString等） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <!-- 依赖用于测试开始 -->
        <!-- jackson: fastjson -->
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
            <version>${fastjson2.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- 高性能深拷贝(二进制序列化/反序列化)：Kryo、FST(最快) -->
        <!--<dependency>
            <groupId>de.ruedigermoeller</groupId>
            <artifactId>fst</artifactId>
            <version>${fst.version}</version>
             <scope>test</scope>
        </dependency>-->
        <!-- 高性能对象映射：orika（基于Javassist字节码操作） -->
        <dependency>
            <groupId>ma.glasnost.orika</groupId>
            <artifactId>orika-core</artifactId>
            <version>${orika.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- 高性能XML处理 -->
        <dependency>
            <groupId>com.ximpleware</groupId>
            <artifactId>vtd-xml</artifactId>
            <version>${vtd.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- 单元测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <artifactId>jakarta.annotation-api</artifactId>
                    <groupId>jakarta.annotation</groupId>
                </exclusion>
                <exclusion>
                    <artifactId>slf4j-api</artifactId>
                    <groupId>org.slf4j</groupId>
                </exclusion>
                <exclusion>
                    <artifactId>objenesis</artifactId>
                    <groupId>org.objenesis</groupId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- 解决IDEA不兼容 -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- JMH 核心 -->
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>${jmh.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- JMH 注解处理器（编译时生成测试代码） -->
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>${jmh.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- 依赖用于测试结束 -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>${maven-source-plugin.version}</version>
                <configuration>
                    <attach>true</attach>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${maven-javadoc-plugin.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!-- 禁用严格语法检测 -->
                    <doclint>none</doclint>
                    <!-- 指定源文件的编码，也可以使用jvm属性，如：-Dfile.encoding -->
                    <encoding>UTF-8</encoding>
                    <!-- 指定生成的HTML文件的编码 -->
                    <docencoding>UTF-8</docencoding>
                    <!-- 指定 HTML 字符集 -->
                    <charset>UTF-8</charset>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>${maven-gpg-plugin.version}</version>
                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <gpgArguments>
                        <arg>--pinentry-mode</arg>
                        <arg>loopback</arg>
                    </gpgArguments>
                </configuration>
            </plugin>
            <!-- 构件包发布仓库 -->
            <!-- Legacy OSSRH (旧方式)，采用nexus-staging-maven-plugin插件发布 -->
            <!--<plugin>
                <groupId>org.sonatype.plugins</groupId>
                <artifactId>nexus-staging-maven-plugin</artifactId>
                <version>${nexus-staging-maven-plugin.version}</version>
                <extensions>true</extensions>
                <configuration>
                    &lt;!&ndash; autoReleaseAfterClose：是否在关闭后自动发布，但需要依赖Nexus服务状态依赖，发布后需要等待OSSRH同步到Maven Central（通常需数小时） &ndash;&gt;
                    <autoReleaseAfterClose>true</autoReleaseAfterClose>
                    <serverId>ossrh</serverId>
                    <nexusUrl>https://oss.sonatype.org/</nexusUrl>
                </configuration>
            </plugin>-->
            <!-- Central Portal (新方式)，采用central-publishing-maven-plugin插件发布，其必须提供maven-javadoc-plugin插件 -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>${central-publishing-maven-plugin.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <!-- Maven 中央仓库不支持推送快照版本 -->
                    <publishingServerId>central</publishingServerId>
                    <!-- autoPublish：是否全自动发布，在部署后自动完成中央仓库的提交和验证 -->
                    <autoPublish>false</autoPublish>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
